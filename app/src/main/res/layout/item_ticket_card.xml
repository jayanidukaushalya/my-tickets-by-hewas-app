<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Image with Text Overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/image_event_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_event_placeholder"
                android:contentDescription="@null" />

            <!-- Gradient Overlay for readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ticket_gradient_overlay" />

            <!-- Text Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/text_event_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="Grand Tour" />

                <TextView
                    android:id="@+id/text_event_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/white"
                    android:alpha="0.9"
                    tools:text="Thu, 02 Apr | 10:30 AM" />

            </LinearLayout>

            <!-- Status Badge (Top Right) -->
            <TextView
                android:id="@+id/text_ticket_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/spacing_sm"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textStyle="bold"
                tools:text="Used"
                tools:background="@drawable/bg_ticket_status_used"
                tools:textColor="@color/ticket_used" />

        </FrameLayout>

        <!-- Body: Combined Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_ticket_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/price_gold"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="VIP"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_purchase_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:alpha="0.7"
                    tools:text="Purchased 20 Mar 2026" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_ticket_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/price_gold"
                android:textStyle="bold"
                tools:text="1 Ticket | LKR 300.00" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

